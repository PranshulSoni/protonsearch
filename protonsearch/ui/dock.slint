import { LineEdit, ScrollView, ComboBox, Palette } from "std-widgets.slint";

export global DockStyle {
    in-out property <int> appearance: 0;
    out property <color> foreground: appearance == 1 ? #f7f5f1 : #191b20;
    out property <color> secondary: appearance == 1 ? #c4c1bb : #555863;
    // shortcut: glass uses translucency without desktop blur; upgrade when per-widget backdrop filtering is supported.
    out property <color> surface: appearance == 1 ? #25272af7 : appearance == 2 ? #e8eaf0c9 : #f3f2f5fa;
    out property <color> panel: appearance == 1 ? #25272afa : appearance == 2 ? #e8eaf0ee : #f3f2f5fc;
    out property <color> rim: appearance == 1 ? #ffffff1c : appearance == 2 ? #ffffffd9 : #ffffffc9;
    out property <color> hover: appearance == 1 ? #ffffff12 : #171b230b;
    out property <color> pressed: appearance == 1 ? #ffffff20 : #171b2318;
    out property <color> control: appearance == 1 ? #ffffff0b : #171b2307;
    out property <color> divider: appearance == 1 ? #ffffff20 : #171b231c;
    out property <color> calendar-accent: appearance == 1 ? #ff746c : #c72f30;
}

export struct SystemStatus {
    network-icon: image, sound-icon: image, battery-icon: image,
    network-text: string, sound-text: string, battery-text: string,
}

export struct DockItem {
    id: string, kind: string, title: string, subtitle: string, value: string,
    icon: image, width: float, running: bool, active: bool, progress: float,
    group-id: string, surface-width: float, gap-before: float,
}
export struct PanelItem {
    id: string, title: string, subtitle: string, value: string,
    icon: image, selected: bool, progress: float,
}

// One keyboard and accessibility contract for custom glass controls.
component GlassButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> housing-hover: false;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback activated();
    callback context();
    border-radius: 12px;
    background: touch.pressed ? DockStyle.pressed : selected ? DockStyle.hover : !housing-hover && touch.has-hover ? DockStyle.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: DockStyle.foreground;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.activated(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.activated(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                focus.focus(); root.context();
            }
        }
    }
    @children
}

component HorizontalFlickable inherits Flickable {
    viewport-height: self.height;
    // The layout keeps its natural width; the host caps only the outer window.
    @children
}

// Compact controls deliberately share a fixed frame. Hover only transforms artwork.
component QuietButton inherits GlassButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    label: root.text;
    height: 32px;
    vertical-stretch: 0;
    min-width: 40px;
    background: !root.enabled ? transparent : root.pressed || root.selected ? DockStyle.pressed : root.hovered ? DockStyle.hover : DockStyle.control;
    opacity: root.enabled ? 1 : 0.4;
    activated => { if root.enabled { root.clicked(); } }
    Text { text: root.text; color: DockStyle.foreground; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

// A neutral volume control keeps the dock independent of the Windows accent colour.
component VolumeSlider inherits Rectangle {
    in-out property <float> value: 0;
    callback changed(float);
    height: 32px;
    min-width: 160px;
    accessible-role: slider;
    accessible-label: "Volume, " + round(root.value) + " percent";
    forward-focus: keyboard;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.value = max(0, root.value - 2); root.changed(root.value); return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.value = min(100, root.value + 2); root.changed(root.value); return accept;
            }
            return reject;
        }
    }
    Rectangle {
        x: 8px; y: 12px; width: parent.width - 16px; height: 8px;
        border-radius: 4px; background: DockStyle.divider;
        Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.value / 100, 0, 1); height: parent.height; border-radius: 4px; background: DockStyle.foreground; }
    }
    Rectangle {
        x: 8px + (parent.width - 16px) * clamp(root.value / 100, 0, 1) - 7px;
        y: 9px; width: 14px; height: 14px; border-radius: 7px;
        background: DockStyle.foreground;
        border-width: keyboard.has-focus ? 2px : 0px; border-color: DockStyle.secondary;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { keyboard.focus(); root.value = clamp((self.mouse-x - 8px) / (self.width - 16px) * 100, 0, 100); root.changed(root.value); }
        }
        moved => { if self.pressed { root.value = clamp((self.mouse-x - 8px) / (self.width - 16px) * 100, 0, 100); root.changed(root.value); } }
    }
}

component WidgetHousing inherits Rectangle {
    in property <bool> hovered: false;
    background: root.hovered ? (DockStyle.appearance == 1 ? #3a3c40 : #ffffff) : DockStyle.surface;
    border-radius: min(16px, self.height / 3);
    border-width: 1px;
    border-color: DockStyle.rim;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: #00000030;
    @children
}

export component DockWindow inherits Window {
    title: "Proton Dock";
    background: transparent;
    no-frame: true;
    default-font-family: "Segoe UI Variable";
    in-out property <[DockItem]> items;
    in-out property <SystemStatus> system-status;
    in-out property <string> profile: "Work";
    in-out property <bool> editing: false;
    in-out property <string> status;
    in-out property <float> dock-width: 1100;
    in-out property <float> dock-height: 82;
    in-out property <float> icon-size: 48;
    in-out property <bool> reduced-motion: false;
    private property <string> hovered-group;
    out property <float> scroll-offset: -scroll.viewport-x / 1px;
    callback item-clicked(string);
    callback item-context(string);
    callback profile-selected(string);
    callback edit-toggled();
    callback item-resized(string, float);
    callback item-moved(string, int);
    callback close-requested();
    width: root.dock-width * 1px;
    height: root.dock-height * 1px;
    HorizontalLayout {
        x: 6px; y: 7px;
        width: parent.width - 12px; height: parent.height - 14px;
        spacing: root.items.length > 0 ? 10px : 0px;
        scroll := HorizontalFlickable {
            horizontal-stretch: 1;
            viewport-width: track.width;
            track := HorizontalLayout {
                width: self.preferred-width;
                height: scroll.height;
                spacing: 0px;
                for item in root.items : Rectangle {
                    width: (item.width + item.gap-before) * 1px;
                    horizontal-stretch: 0;
                    clip: false;
                    if item.surface-width > 0 : WidgetHousing {
                        x: item.gap-before * 1px;
                        width: item.surface-width * 1px;
                        height: parent.height;
                        hovered: root.hovered-group == item.group-id;
                    }
                    tile := GlassButton {
                        property <bool> icon-only: item.kind != "status" && item.kind != "calendar" && (item.kind == "app" || item.kind == "start" || item.kind == "agents" || item.width < 100);
                        label: item.kind == "status" ? root.system-status.network-text + ", " + root.system-status.sound-text + ", " + root.system-status.battery-text : item.title + (item.value == "" ? "" : ", " + item.value);
                        selected: item.active;
                        housing-hover: true;
                        changed hovered => {
                            if self.hovered { root.hovered-group = item.group-id; }
                            else if root.hovered-group == item.group-id { root.hovered-group = ""; }
                        }
                        x: item.gap-before * 1px;
                        y: 0px;
                        width: item.width * 1px;
                        height: parent.height;
                        border-radius: 15px;
                        activated => { root.item-clicked(item.id); }
                        context => { root.item-context(item.id); }
                        if item.kind == "app" : Image {
                            source: item.icon;
                            width: min(parent.width - 8px, parent.height - 6px, (min(root.icon-size, 44) + (!root.reduced-motion && tile.hovered ? 4 : 0) - (!root.reduced-motion && tile.pressed ? 3 : 0)) * 1px);
                            height: self.width;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - (!root.reduced-motion && tile.hovered ? 3px : 1px);
                            opacity: tile.pressed ? 0.75 : 1;
                            image-fit: contain;
                            animate width { duration: root.reduced-motion ? 0ms : 140ms; easing: ease-out; }
                            animate y { duration: root.reduced-motion ? 0ms : 140ms; easing: ease-out; }
                        }
                        if item.kind == "app" && item.running : Rectangle {
                            width: item.active ? 9px : 4px; height: 3px;
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 3px;
                            border-radius: 2px;
                            background: DockStyle.foreground;
                            animate width { duration: root.reduced-motion ? 0ms : 130ms; }
                        }
                        if item.kind == "status" && tile.height >= 52px : VerticalLayout {
                            padding: 8px; spacing: 5px; alignment: center;
                            HorizontalLayout {
                                spacing: 16px; alignment: center;
                                Image { source: root.system-status.network-icon; width: 23px; height: 20px; image-fit: contain; colorize: DockStyle.foreground; }
                                Image { source: root.system-status.sound-icon; width: 23px; height: 20px; image-fit: contain; colorize: DockStyle.foreground; }
                            }
                            HorizontalLayout {
                                spacing: 7px; alignment: center;
                                Image { source: root.system-status.battery-icon; width: 26px; height: 18px; image-fit: contain; colorize: DockStyle.foreground; }
                                Text { text: root.system-status.battery-text; color: DockStyle.foreground; font-size: 13px; font-weight: 500; overflow: elide; horizontal-stretch: 0; }
                            }
                        }
                        if item.kind == "status" && tile.height < 52px : HorizontalLayout {
                            padding: 5px; spacing: 4px; alignment: center;
                            Image { source: root.system-status.network-icon; width: 17px; height: 17px; image-fit: contain; colorize: DockStyle.foreground; }
                            Image { source: root.system-status.sound-icon; width: 17px; height: 17px; image-fit: contain; colorize: DockStyle.foreground; }
                            Image { source: root.system-status.battery-icon; width: 19px; height: 17px; image-fit: contain; colorize: DockStyle.foreground; }
                            Text { text: root.system-status.battery-text; color: DockStyle.foreground; font-size: 11px; overflow: elide; }
                        }
                        if item.kind == "calendar" : VerticalLayout {
                            spacing: 1px; alignment: center;
                            if tile.height >= 38px : Text { text: item.subtitle; color: DockStyle.calendar-accent; font-size: 10px; font-weight: 600; horizontal-alignment: center; overflow: elide; vertical-stretch: 0; }
                            Text { text: item.value; color: DockStyle.foreground; font-size: min(27px, max(15px, tile.height * 0.48)); font-weight: 500; horizontal-alignment: center; vertical-stretch: 0; }
                        }
                        if item.kind != "app" && tile.icon-only : Image {
                            source: item.icon; width: min(25px, parent.height - 4px); height: self.width;
                            image-fit: contain; colorize: DockStyle.foreground;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - (!root.reduced-motion && tile.hovered ? 2px : 0px);
                            opacity: tile.pressed ? 0.7 : 1;
                            animate y { duration: root.reduced-motion ? 0ms : 130ms; easing: ease-out; }
                        }
                        if item.kind != "app" && item.kind != "status" && item.kind != "calendar" && !tile.icon-only : HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 9px;
                            if item.kind != "clock" : Rectangle {
                                width: 24px; horizontal-stretch: 0;
                                Image { source: item.icon; width: 24px; height: 24px; y: (parent.height - self.height) / 2; image-fit: contain; colorize: DockStyle.foreground; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px;
                                Text {
                                    text: item.kind == "search" ? "Search" : item.value != "" ? item.value : item.title;
                                    color: DockStyle.foreground;
                                    font-size: item.kind == "clock" ? 22px : 15px;
                                    font-weight: item.kind == "clock" || item.kind == "focus" ? 500 : 600;
                                    horizontal-alignment: item.kind == "clock" ? center : left;
                                    overflow: elide; vertical-stretch: 0;
                                }
                                if (item.kind == "weather" || item.kind == "music" || item.kind == "custom-metric") && tile.height >= 48px : Text {
                                    text: item.subtitle; color: DockStyle.secondary; font-size: 11px;
                                    overflow: elide; vertical-stretch: 0;
                                }
                            }
                        }
                        if item.kind != "app" && item.progress > 0 && !tile.icon-only : Rectangle {
                            x: 12px; y: parent.height - 5px;
                            width: parent.width - 24px; height: 2px;
                            border-radius: 1px; background: DockStyle.divider;
                            Rectangle {
                                width: parent.width * clamp(item.progress, 0, 1); height: 2px;
                                border-radius: 1px; background: DockStyle.foreground;
                                animate width { duration: root.reduced-motion ? 0ms : 100ms; }
                            }
                        }
                    }
                }
            }
        }
        WidgetHousing {
            width: 44px; horizontal-stretch: 0;
            hovered: settings-button.hovered;
            settings-button := GlassButton {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                label: "Customize dock"; selected: root.editing;
                housing-hover: true;
                activated => { root.edit-toggled(); }
                Image { source: @image-url("icons/dock/settings.svg"); width: 22px; height: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: DockStyle.foreground; }
            }
        }
    }
}
export component DockPanelWindow inherits Window {
    title: "Proton Widget";
    background: transparent;
    no-frame: true;
    default-font-family: "Segoe UI Variable";
    default-font-size: 13px;
    property <int> appearance: DockStyle.appearance;
    init => { Palette.color-scheme = root.appearance == 1 ? ColorScheme.dark : ColorScheme.light; }
    changed appearance => { Palette.color-scheme = root.appearance == 1 ? ColorScheme.dark : ColorScheme.light; }
    in-out property <SystemStatus> system-status;
    in-out property <float> panel-width: 404;
    in-out property <float> panel-height: 460;
    width: root.panel-width * 1px;
    height: root.panel-height * 1px;
    in-out property <string> panel-kind;
    in-out property <string> panel-title;
    in-out property <string> subtitle;
    in-out property <string> query;
    in-out property <string> body;
    in-out property <string> status;
    in-out property <[PanelItem]> entries;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <string> timer-value;
    in-out property <bool> timer-running;
    in-out property <bool> busy;
    in-out property <bool> edit-mode;
    in-out property <bool> taskbar-hidden: false;
    in-out property <bool> revealed: true;
    in-out property <bool> reduced-motion: false;
    callback action(string);
    callback query-edited(string);
    callback volume-edited(float);
    callback mute-toggled();
    callback closed();
    Rectangle {
        x: 8px; y: root.reduced-motion || root.revealed ? 8px : 18px;
        width: parent.width - 16px; height: parent.height - 16px;
        opacity: root.revealed ? 1 : 0;
        animate y { duration: root.reduced-motion ? 0ms : 140ms; easing: ease-out; }
        animate opacity { duration: root.reduced-motion ? 0ms : 120ms; easing: ease-out; }
        border-radius: 18px;
        border-width: 1px; border-color: DockStyle.rim;
        background: DockStyle.panel;
        drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000038;
        VerticalLayout {
            padding: 18px; spacing: 12px;
            alignment: root.panel-kind == "apps" || root.panel-kind == "windows" || root.panel-kind == "customize" ? LayoutAlignment.stretch : LayoutAlignment.start;
            HorizontalLayout {
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.panel-title; color: DockStyle.foreground; font-size: 20px; font-weight: 600; overflow: elide; }
                    Text { text: root.subtitle; color: DockStyle.secondary; font-size: 12px; overflow: elide; }
                }
                GlassButton {
                    width: 32px; height: 32px; label: "Close panel";
                    activated => { root.closed(); }
                    Text { text: "×"; color: DockStyle.foreground; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if root.panel-kind == "apps" || root.panel-kind == "agents" || root.panel-kind == "windows" || root.panel-kind == "customize" : LineEdit {
                vertical-stretch: 0;
                text <=> root.query;
                placeholder-text: root.panel-kind == "customize" ? "Custom widget: name | value | detail" : "Search " + root.panel-title;
                edited(text) => { root.query-edited(text); }
                accepted => { root.action("submit"); }
            }
            if root.body != "" : Text {
                text: root.body; color: DockStyle.foreground; wrap: word-wrap;
                vertical-stretch: 0; font-size: 13px;
            }
            if root.panel-kind == "focus" : VerticalLayout {
                spacing: 14px; vertical-stretch: 0;
                Text { text: root.timer-value; color: DockStyle.foreground; font-size: 56px; font-weight: 300; horizontal-alignment: center; }
                HorizontalLayout {
                    QuietButton { text: root.timer-running ? "Pause" : "Start focus"; clicked => { root.action(root.timer-running ? "pause" : "start"); } }
                    QuietButton { text: "Reset"; clicked => { root.action("reset"); } }
                }
            }
            if root.panel-kind == "audio" || root.panel-kind == "status" : VerticalLayout {
                spacing: 14px; vertical-stretch: 0;
                Text { text: root.muted ? "Muted" : round(root.volume) + "%"; color: DockStyle.foreground; font-size: 42px; horizontal-alignment: center; }
                VolumeSlider { value <=> root.volume; changed(value) => { root.volume-edited(value); } }
                QuietButton { text: root.muted ? "Unmute" : "Mute"; clicked => { root.mute-toggled(); } }
            }
            if root.panel-kind == "status" : HorizontalLayout {
                vertical-stretch: 0; spacing: 8px;
                QuietButton { text: root.system-status.network-text; clicked => { root.action("settings:network"); } }
                QuietButton { text: root.system-status.battery-text; clicked => { root.action("settings:power"); } }
                QuietButton { text: "Sound settings"; clicked => { root.action("settings:audio"); } }
            }
            if root.panel-kind == "music" : HorizontalLayout {
                vertical-stretch: 0;
                QuietButton { text: "Previous"; clicked => { root.action("previous"); } }
                QuietButton { text: "Play / Pause"; clicked => { root.action("play"); } }
                QuietButton { text: "Next"; clicked => { root.action("next"); } }
            }
            if root.panel-kind == "customize" : HorizontalLayout {
                vertical-stretch: 0; spacing: 6px;
                QuietButton { text: "Light"; selected: DockStyle.appearance == 0; clicked => { root.action("appearance:light"); } }
                QuietButton { text: "Dark"; selected: DockStyle.appearance == 1; clicked => { root.action("appearance:dark"); } }
                QuietButton { text: "Liquid glass"; selected: DockStyle.appearance == 2; clicked => { root.action("appearance:glass"); } }
            }
            if root.panel-kind == "customize" : HorizontalLayout {
                vertical-stretch: 0;
                ComboBox { model: ["Work", "Home", "Presentation"]; selected(value) => { root.action("profile:" + value); } }
                QuietButton { text: "Add widget"; clicked => { root.action("add-custom"); } }
            }
            if root.panel-kind == "customize" : HorizontalLayout {
                vertical-stretch: 0;
                QuietButton { text: "Height −"; clicked => { root.action("height-less"); } }
                QuietButton { text: "Height +"; clicked => { root.action("height-more"); } }
                QuietButton { text: "Work area"; clicked => { root.action("reserve"); } }
                QuietButton { text: "Disable"; clicked => { root.action("disable"); } }
            }
            if root.panel-kind == "customize" : QuietButton {
                text: root.taskbar-hidden ? "Windows taskbar: hidden · click to restore" : "Hide the Windows taskbar";
                clicked => { root.action("toggle-taskbar"); }
            }
            if root.panel-kind == "apps" || root.panel-kind == "windows" || root.panel-kind == "customize" : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 7px;
                    for entry in root.entries : Rectangle {
                        height: root.panel-kind == "customize" ? 92px : 64px;
                        background: DockStyle.control; border-radius: 10px;
                        border-width: 1px; border-color: entry.selected ? DockStyle.secondary : DockStyle.divider;
                        VerticalLayout {
                            padding: 6px; spacing: 3px;
                            GlassButton {
                                label: entry.title + ", " + entry.subtitle;
                                activated => { root.action(entry.id); }
                                HorizontalLayout {
                                    padding: 5px; spacing: 11px;
                                    Image { source: entry.icon; width: 38px; height: 38px; image-fit: contain; colorize: root.panel-kind == "customize" ? DockStyle.foreground : transparent; }
                                    VerticalLayout {
                                        spacing: 4px; alignment: center;
                                        Text { text: entry.title; color: DockStyle.foreground; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: entry.subtitle; color: DockStyle.secondary; font-size: 11px; overflow: elide; }
                                    }
                                    if root.panel-kind == "apps" : QuietButton { min-width: 48px; max-width: 48px; horizontal-stretch: 0; text: entry.selected ? "Unpin" : "Pin"; clicked => { root.action("pin:" + entry.id); } }
                                    if root.panel-kind == "windows" : QuietButton { min-width: 56px; max-width: 56px; horizontal-stretch: 0; text: "Close"; clicked => { root.action("close:" + entry.id); } }
                                    if entry.value != "" : Text { text: entry.value; color: DockStyle.foreground; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
                                }
                            }
                            if root.panel-kind == "customize" : HorizontalLayout {
                                height: 30px; spacing: 4px;
                                QuietButton { text: entry.selected ? "Hide" : "Show"; clicked => { root.action("customize:" + entry.id + ":toggle"); } }
                                QuietButton { text: "‹"; clicked => { root.action("customize:" + entry.id + ":left"); } }
                                QuietButton { text: "−"; clicked => { root.action("customize:" + entry.id + ":smaller"); } }
                                QuietButton { text: "+"; clicked => { root.action("customize:" + entry.id + ":larger"); } }
                                QuietButton { text: "›"; clicked => { root.action("customize:" + entry.id + ":right"); } }
                            }
                        }
                    }
                }
            }
            if root.busy || root.status != "" : Text { text: root.busy ? "Updating…" : root.status; color: DockStyle.secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            if root.panel-kind == "apps" || root.panel-kind == "windows" || root.panel-kind == "customize" || root.panel-kind == "audio" || root.panel-kind == "network" || root.panel-kind == "power" || root.panel-kind == "clock" || root.panel-kind == "weather" || root.panel-kind == "agents" : HorizontalLayout {
                vertical-stretch: 0;
                if root.panel-kind == "apps" || root.panel-kind == "windows" || root.panel-kind == "customize" : QuietButton { text: "Refresh"; enabled: !root.busy; clicked => { root.action("refresh"); } }
                if root.panel-kind == "audio" || root.panel-kind == "network" || root.panel-kind == "power" || root.panel-kind == "clock" || root.panel-kind == "weather" || root.panel-kind == "agents" : QuietButton { text: root.panel-kind == "agents" ? "Open Agents" : root.panel-kind == "audio" ? "Sound settings" : root.panel-kind == "network" ? "Network settings" : root.panel-kind == "clock" ? "Date and time settings" : root.panel-kind == "weather" ? "Open Weather" : "Power settings"; clicked => { root.action("settings"); } }
            }
        }
    }
}

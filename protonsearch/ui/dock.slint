import { LineEdit, Slider, ScrollView, ComboBox } from "std-widgets.slint";

export struct DockItem {
    id: string, kind: string, title: string, subtitle: string, value: string,
    icon: image, width: float, running: bool, active: bool, progress: float,
}
export struct PanelItem {
    id: string, title: string, subtitle: string, value: string,
    icon: image, selected: bool, progress: float,
}

// One keyboard and accessibility contract for custom glass controls.
component GlassButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    callback activated();
    callback context();
    border-radius: 12px;
    background: touch.pressed ? #ffffff24 : touch.has-hover ? #ffffff12 : selected ? #ffffff10 : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #ffffff90;
    animate background { duration: 130ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.activated(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.activated(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                focus.focus(); root.context();
            }
        }
    }
    @children
}

component HorizontalFlickable inherits Flickable {
    viewport-height: self.height;
    // The layout keeps its natural width; the host caps only the outer window.
    @children
}

// Compact controls deliberately share a fixed frame. Hover only transforms artwork.
component QuietButton inherits GlassButton {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    label: root.text;
    min-height: 32px;
    min-width: 30px;
    background: !root.enabled ? #ffffff04 : root.pressed ? #ffffff24 : root.hovered ? #ffffff17 : #ffffff0b;
    opacity: root.enabled ? 1 : 0.4;
    activated => { if root.enabled { root.clicked(); } }
    Text { text: root.text; color: #f0f1f3; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

export component DockWindow inherits Window {
    title: "Proton Dock";
    background: transparent;
    no-frame: true;
    default-font-family: "Segoe UI Variable";
    in-out property <[DockItem]> items;
    in-out property <string> profile: "Work";
    in-out property <bool> editing: false;
    in-out property <string> status;
    in-out property <float> dock-height: 82;
    in-out property <float> icon-size: 48;
    callback item-clicked(string);
    callback item-context(string);
    callback profile-selected(string);
    callback edit-toggled();
    callback item-resized(string, float);
    callback item-moved(string, int);
    callback close-requested();
    width: 1100px;
    height: root.dock-height * 1px;
    Rectangle {
        x: 6px; y: 7px;
        width: parent.width - 12px; height: parent.height - 14px;
        background: @linear-gradient(180deg, #414349d9 0%, #24262cde 100%);
        border-radius: 21px;
        border-width: 1px;
        border-color: #ffffff38;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000045;
        HorizontalLayout {
            padding: 4px; spacing: 4px;
            scroll := HorizontalFlickable {
                viewport-width: track.width;
                track := HorizontalLayout {
                    width: self.preferred-width;
                    height: scroll.height;
                    spacing: 4px;
                    for item[index] in root.items : tile := GlassButton {
                        property <bool> icon-only: item.kind == "app" || item.kind == "start" || item.kind == "search" || item.kind == "agents" || item.width < 85;
                        label: item.title + (item.value == "" ? "" : ", " + item.value);
                        selected: item.active;
                        width: max(60px, item.width * 1px);
                        height: parent.height;
                        activated => { root.item-clicked(item.id); }
                        context => { root.item-context(item.id); }
                        if item.kind == "app" : Image {
                            source: item.icon;
                            width: min(parent.width - 8px, parent.height - 6px, (root.icon-size + (tile.hovered ? 5 : 0) - (tile.pressed ? 3 : 0)) * 1px);
                            height: self.width;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - (tile.hovered ? 3px : 1px);
                            image-fit: contain;
                            animate width { duration: 140ms; easing: ease-out; }
                            animate y { duration: 140ms; easing: ease-out; }
                        }
                        if item.kind == "app" && item.running : Rectangle {
                            width: item.active ? 9px : 4px; height: 3px;
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 3px;
                            border-radius: 2px;
                            background: #f5f5f5;
                            animate width { duration: 130ms; }
                        }
                        if item.kind != "app" && tile.icon-only : Image {
                            source: item.icon; width: 25px; height: 25px;
                            image-fit: contain;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2 - (tile.hovered ? 2px : 0px);
                            opacity: tile.pressed ? 0.7 : 1;
                            animate y { duration: 130ms; easing: ease-out; }
                        }
                        if item.kind != "app" && !tile.icon-only : HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 9px;
                            if item.kind != "clock" : Image {
                                source: item.icon; width: 24px; height: 24px;
                                image-fit: contain; vertical-stretch: 0;
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px;
                                Text {
                                    text: item.value != "" ? item.value : item.title;
                                    color: #fafafa;
                                    font-size: item.kind == "clock" ? 21px : 16px;
                                    font-weight: item.kind == "clock" || item.kind == "focus" ? 500 : 600;
                                    overflow: elide; vertical-stretch: 0;
                                }
                                if item.kind == "weather" || item.kind == "music" || item.kind == "custom-metric" : Text {
                                    text: item.subtitle;
                                    color: #c4c6cd; font-size: 10px;
                                    overflow: elide; vertical-stretch: 0;
                                }
                            }
                        }
                        if item.kind != "app" && item.progress > 0 && !tile.icon-only : Rectangle {
                            x: 12px; y: parent.height - 6px;
                            width: parent.width - 24px; height: 2px;
                            border-radius: 1px; background: #ffffff16;
                            Rectangle {
                                width: parent.width * clamp(item.progress, 0, 1); height: 2px;
                                border-radius: 1px; background: #d9dbe1;
                                animate width { duration: 100ms; }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; height: parent.height - 22px; vertical-stretch: 0; background: #ffffff20; }
            GlassButton {
                width: 38px; label: "Customize dock"; selected: root.editing;
                activated => { root.edit-toggled(); }
                Image { source: @image-url("icons/dock/settings.svg"); width: 22px; height: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
    }
}

export component DockPanelWindow inherits Window {
    title: "Proton Widget";
    background: transparent;
    no-frame: true;
    default-font-family: "Segoe UI Variable";
    default-font-size: 13px;
    width: 404px;
    height: 460px;
    in-out property <string> panel-kind;
    in-out property <string> panel-title;
    in-out property <string> subtitle;
    in-out property <string> query;
    in-out property <string> body;
    in-out property <string> status;
    in-out property <[PanelItem]> entries;
    in-out property <float> volume;
    in-out property <bool> muted;
    in-out property <string> timer-value;
    in-out property <bool> timer-running;
    in-out property <bool> busy;
    in-out property <bool> edit-mode;
    in-out property <bool> taskbar-hidden: false;
    in-out property <bool> revealed: true;
    callback action(string);
    callback query-edited(string);
    callback volume-edited(float);
    callback mute-toggled();
    callback closed();
    Rectangle {
        x: 8px; y: root.revealed ? 8px : 18px;
        width: parent.width - 16px; height: parent.height - 16px;
        opacity: root.revealed ? 1 : 0;
        animate y { duration: 140ms; easing: ease-out; }
        animate opacity { duration: 120ms; easing: ease-out; }
        border-radius: 20px;
        border-width: 1px; border-color: #ffffff30;
        background: @linear-gradient(160deg, #3b3d43ed 0%, #23252bf5 100%);
        drop-shadow-blur: 20px; drop-shadow-color: #00000055;
        VerticalLayout {
            padding: 18px; spacing: 12px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.panel-title; color: #f7f7f8; font-size: 20px; font-weight: 600; overflow: elide; }
                    Text { text: root.subtitle; color: #b7b9c1; font-size: 12px; overflow: elide; }
                }
                GlassButton {
                    width: 32px; height: 32px; label: "Close panel";
                    activated => { root.closed(); }
                    Text { text: "×"; color: #cbd5e4; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if root.panel-kind == "apps" || root.panel-kind == "agents" || root.panel-kind == "windows" || root.panel-kind == "weather" || root.panel-kind == "customize" : LineEdit {
                text <=> root.query;
                placeholder-text: root.panel-kind == "weather" ? "City or coordinates" : root.panel-kind == "customize" ? "Custom widget: name | value | detail" : "Search " + root.panel-title;
                edited(text) => { root.query-edited(text); }
                accepted => { root.action("submit"); }
            }
            if root.body != "" : Text {
                text: root.body; color: #d3d4da; wrap: word-wrap;
                vertical-stretch: 0; font-size: 13px;
            }
            if root.panel-kind == "focus" : VerticalLayout {
                spacing: 18px; vertical-stretch: 0;
                Text { text: root.timer-value; color: #f7f7f8; font-size: 68px; font-weight: 300; horizontal-alignment: center; }
                HorizontalLayout {
                    QuietButton { text: root.timer-running ? "Pause" : "Start focus"; clicked => { root.action(root.timer-running ? "pause" : "start"); } }
                    QuietButton { text: "Reset"; clicked => { root.action("reset"); } }
                }
            }
            if root.panel-kind == "audio" : VerticalLayout {
                spacing: 18px; vertical-stretch: 0;
                Text { text: root.muted ? "Muted" : round(root.volume) + "%"; color: #f7f7f8; font-size: 42px; horizontal-alignment: center; }
                Slider { minimum: 0; maximum: 100; value: root.volume; changed(value) => { root.volume-edited(value); } }
                QuietButton { text: root.muted ? "Unmute" : "Mute"; clicked => { root.mute-toggled(); } }
            }
            if root.panel-kind == "music" : HorizontalLayout {
                vertical-stretch: 0;
                QuietButton { text: "Previous"; clicked => { root.action("previous"); } }
                QuietButton { text: "Play / Pause"; clicked => { root.action("play"); } }
                QuietButton { text: "Next"; clicked => { root.action("next"); } }
            }
            if root.panel-kind == "customize" : HorizontalLayout {
                vertical-stretch: 0;
                ComboBox { model: ["Work", "Home", "Presentation"]; selected(value) => { root.action("profile:" + value); } }
                QuietButton { text: "Add widget"; clicked => { root.action("add-custom"); } }
            }
            if root.panel-kind == "customize" : HorizontalLayout {
                vertical-stretch: 0;
                QuietButton { text: "Height −"; clicked => { root.action("height-less"); } }
                QuietButton { text: "Height +"; clicked => { root.action("height-more"); } }
                QuietButton { text: "Work area"; clicked => { root.action("reserve"); } }
                QuietButton { text: "Disable"; clicked => { root.action("disable"); } }
            }
            if root.panel-kind == "customize" : QuietButton {
                text: root.taskbar-hidden ? "Windows taskbar: hidden · click to restore" : "Hide the Windows taskbar";
                clicked => { root.action("toggle-taskbar"); }
            }
            ScrollView {
                VerticalLayout {
                    spacing: 7px;
                    for entry in root.entries : Rectangle {
                        height: root.panel-kind == "customize" ? 92px : 64px;
                        background: #ffffff06; border-radius: 12px;
                        border-width: 1px; border-color: entry.selected ? #ffffff38 : #ffffff0b;
                        VerticalLayout {
                            padding: 6px; spacing: 3px;
                            GlassButton {
                                label: entry.title + ", " + entry.subtitle;
                                activated => { root.action(entry.id); }
                                HorizontalLayout {
                                    padding: 5px; spacing: 11px;
                                    Image { source: entry.icon; width: 38px; height: 38px; image-fit: contain; }
                                    VerticalLayout {
                                        spacing: 4px; alignment: center;
                                        Text { text: entry.title; color: #f7f7f8; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: entry.subtitle; color: #b5b7bf; font-size: 11px; overflow: elide; }
                                    }
                                    if root.panel-kind == "apps" : QuietButton { text: entry.selected ? "Unpin" : "Pin"; clicked => { root.action("pin:" + entry.id); } }
                                    if root.panel-kind == "windows" : QuietButton { text: "Close"; clicked => { root.action("close:" + entry.id); } }
                                    Text { text: entry.value; color: #d9dbe1; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
                                }
                            }
                            if root.panel-kind == "customize" : HorizontalLayout {
                                height: 30px; spacing: 4px;
                                QuietButton { text: entry.selected ? "Hide" : "Show"; clicked => { root.action("customize:" + entry.id + ":toggle"); } }
                                QuietButton { text: "‹"; clicked => { root.action("customize:" + entry.id + ":left"); } }
                                QuietButton { text: "−"; clicked => { root.action("customize:" + entry.id + ":smaller"); } }
                                QuietButton { text: "+"; clicked => { root.action("customize:" + entry.id + ":larger"); } }
                                QuietButton { text: "›"; clicked => { root.action("customize:" + entry.id + ":right"); } }
                            }
                        }
                    }
                }
            }
            Text { text: root.busy ? "Updating…" : root.status; color: #b5b7bf; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            HorizontalLayout {
                vertical-stretch: 0;
                QuietButton { text: "Back"; clicked => { root.action("back"); } }
                QuietButton { text: "Refresh"; enabled: !root.busy; clicked => { root.action("refresh"); } }
                QuietButton { text: root.panel-kind == "agents" ? "Open Agents" : "Settings"; clicked => { root.action("settings"); } }
            }
        }
    }
}

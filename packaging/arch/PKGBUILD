pkgname=protonsearch-linux
pkgver=1.0.0
pkgrel=1
pkgdesc='Linux-native ProtonSearch search and system-provider backend'
arch=('x86_64' 'aarch64')
url='https://github.com/PranshulSoni/Project-Raycast'
license=('MIT')
depends=('glibc' 'gtk4')
optdepends=(
  'xdg-utils: open files and URLs'
  'wl-clipboard: Wayland clipboard copy/paste'
  'cliphist: persistent Wayland clipboard history'
  'sqlite: browser history provider'
  'tesseract: OCR search for images'
  'poppler: PDF content search through pdftotext'
  'grim: Hyprland screenshot capture'
  'slurp: screenshot area selection'
  'networkmanager: Wi-Fi provider'
  'bluez-utils: Bluetooth provider'
  'wireplumber: PipeWire audio provider'
  'brightnessctl: backlight provider'
  'playerctl: MPRIS media provider'
  'power-profiles-daemon: power profile provider'
  'hyprland: Hyprland IPC provider'
)
makedepends=('cargo' 'git')
source=("Project-Raycast::git+https://github.com/PranshulSoni/Project-Raycast.git")
sha256sums=('SKIP')

build() {
  cd "$srcdir/Project-Raycast"
  cargo build --release --locked --manifest-path protonsearch-linux/Cargo.toml
}

package() {
  cd "$srcdir/Project-Raycast"
  install -Dm755 protonsearch-linux/target/release/protonsearch-linux "$pkgdir/usr/bin/protonsearch-linux"
  install -Dm644 packaging/arch/protonsearch-linux.desktop "$pkgdir/usr/share/applications/protonsearch-linux.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/linux/DEPENDENCIES.md "$pkgdir/usr/share/doc/$pkgname/DEPENDENCIES.md"
  install -Dm644 docs/linux/SETTINGS_MAPPING.md "$pkgdir/usr/share/doc/$pkgname/SETTINGS_MAPPING.md"
}

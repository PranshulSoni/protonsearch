[Desktop Entry]
Type=Application
Name=ProtonSearch
GenericName=Application Launcher
Comment=Fast Linux launcher for apps, files, settings, and actions
Exec="@BINDIR@/protonsearch-linux" gui
TryExec=@BINDIR@/protonsearch-linux
Path=@DATADIR@/protonsearch
Terminal=false
StartupNotify=true
StartupWMClass=com.protonsearch.Linux
Icon=protonsearch
Categories=Utility;
Keywords=launcher;search;apps;files;settings;
Actions=Settings;

[Desktop Action Settings]
Name=Open ProtonSearch Settings
Exec="@BINDIR@/protonsearch-linux" settings-ui
